// Copy this file to Secrets.swift and fill in the real values.
// Secrets.swift is gitignored — never commit the real values.
enum ClaudeProxySecrets {
    // Railway domain — run: railway domain   (inside the ledger-proxy/ folder)
    static let proxyBaseURL = "https://YOUR-RAILWAY-DOMAIN.up.railway.app"
    // Must match the APP_SECRET environment variable set on the Railway service.
    static let appSecret    = "YOUR-APP-SECRET-HERE"
}
