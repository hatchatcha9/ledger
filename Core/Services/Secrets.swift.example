// Copy this file to Secrets.swift and fill in the values.
// Secrets.swift is gitignored — never commit it.
//
// Values come from your Railway dashboard:
//   proxyBaseURL — run `railway domain` in the ledger-proxy service directory
//   appSecret    — the APP_SECRET environment variable you set on Railway

enum ClaudeProxySecrets {
    static let proxyBaseURL = "https://your-service.up.railway.app"
    static let appSecret    = "your-app-secret-here"
}
